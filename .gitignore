wandb/

# --- Databases ---
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
.pgpass

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
Icon?

# --- IDEs & Editors ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# IntelliJ / PyCharm
.idea/
*.iws
*.iml
*.ipr
cmake-build-*/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
! [._]*.svg
[._]sw[a-p]
[._]sba
[._]sbc
[._]undo
.netrwhist
tags

# --- Logs & Temp ---
*.log
logs/
tmp/
temp/
*.bak
*.swp
*.swo
*~
.nfs*

# --- Compressions & Archives ---
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# --- Docker ---
.dockerignore
# Docker images are usually not committed, but some people use docker-compose.override.yml
docker-compose.override.yml
