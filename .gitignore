# ==========================================
# THE ULTIMATE .GITIGNORE FOR DEV-ALAYA
# Covers: Python, Node.js, ML, IDEs, OS, & Tools
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv/
ENV/
env/
pythonenv*
.python-version
pip-log.txt
pip-delete-this-directory.txt
.toast
.lucid
.flaskenv
instance/
.pytest_cache/
.coverage
htmlcov/
.noserc
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pyre/
.pytype/
cython_debug/

# --- Jupyter Notebook ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Node.js / Frontend ---
node_modules/
jspm_packages/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.js.map
*.tgz
.yarn-integrity
.env.test
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
.next/
out/
.nuxt/
dist/
.cache/

# --- Machine Learning & Data ---
*.h5
*.pth
*.pt
*.pkl
*.pickle
*.npy
*.npz
*.joblib
*.dvc
data/
datasets/
uploads/
results/
